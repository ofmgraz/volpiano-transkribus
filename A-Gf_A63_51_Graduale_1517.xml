            <ab facs="#facs_3_rA9gc_12" type="rubrik2">
               <lb facs="#facs_3_line_1691584172506_44" n="N001"/>In omnibus dominicis per annum Finita terica a sacer
               <lb facs="#facs_3_line_1691584175671_49" n="N002"/>dote celebraturo missam aspergatur aqua benedicta
               <lb facs="#facs_3_line_1691584181378_54" n="N003"/>altare maius tantum genibus coram altari flexis et statim
               <lb facs="#facs_3_line_1691584185236_59" n="N004"/>a cantore incipiatur An. Asperges me domine. Ps. Miserere mei
               <lb facs="#facs_3_line_1691584196424_64" n="N005"/>deus V. Gloria patri sicut erat etc. et repetitur An Asper 
               <lb facs="#facs_3_line_1691584201000_69" n="N006"/>ges me domine etc. et a sacerdote asperguntur fraters: An.
            </ab>
            <ab facs="#facs_3_ro3JE_2" type="initiale_fleuro_lombarde">
               <lb facs="#facs_3_line_1695810915635_104" n="N001"/>A
            </ab>
