               <lb facs="#facs_3_line_1691584249940_106" n="N001"/>Gloria patri
            </ab>
            <ab facs="#facs_3_r0Jcl_11" type="rubrik2">
               <lb facs="#facs_3_line_1691584253915_111" n="N001"/>Superdicta An. predicto dicatur in asper
               <lb facs="#facs_3_line_1691584258031_116" n="N002"/>sione aque benedicte in dominicis
               <lb facs="#facs_3_line_1691584262036_121" n="N003"/>per totum annum excepto quis in domini-
               <lb facs="#facs_3_line_1691584267562_126" n="N004"/>ca de passione et dominica palma-
               <lb facs="#facs_3_line_1691584272399_131" n="N005"/>rum non dicitur Gloria patri. sed
               <lb facs="#facs_3_line_1691584275681_136" n="N006"/>post uersum Miserere repetatur in-
               <lb facs="#facs_3_line_1691584280159_141" n="N007"/>mediate An. Asperges me. excepto tempore pascali scilicet ad do-
               <lb facs="#facs_3_line_1691584284549_146" n="N008"/>minica pasce usque ad penthecosten. quo tempore cantatur communiter
               <lb facs="#facs_3_line_1691584290070_151" n="N009"/>An. Vidi aquam egredientem etc. Ps. Confitemini domino V. Gloria patri.
               <lb facs="#facs_3_line_1691585052462_206" n="N010"/>Sicut erat etc. Repetatur An. Vidi aquam egredientem de templo:
               <lb facs="#facs_3_line_1691585055801_211" n="N011"/>Sequitur Antiphona : 717 :
