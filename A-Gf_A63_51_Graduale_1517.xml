               <lb facs="#facs_3_line_1695814860425_173" n="N001"/>c3 z3 , z3 l4 z4 l4 z3 , l3 z2 , l2 , l3 , z2 l3 , z3 l3 z2 l2 , z2 , z1 l2 z1 , z1 cu_z1 
