            </ab>
            <ab facs="#facs_3_r9G1K_18" type="text">
               <lb facs="#facs_3_line_1691584206381_74" n="N001"/>sperges me domine yso
            </ab>
            <ab facs="#facs_3_rPMpj_8" type="notation">
